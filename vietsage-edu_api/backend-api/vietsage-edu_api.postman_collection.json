{
  "info": {
    "name": "Vietsage Education API (RBAC & HN212)",
    "description": "Bộ sưu tập API hoàn chỉnh cho Vietsage Education API gồm: Xác thực JWT & xoay vòng token, Phân quyền RBAC (Admin, Manager, Staff), Tiếp nhận sự kiện máy chấm công HN212, Truy vấn chấm công, Kiểm tra hệ thống.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "adminAccessToken",
      "value": ""
    },
    {
      "key": "staffAccessToken",
      "value": ""
    },
    {
      "key": "currentAccessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "deviceApiKey",
      "value": "hn212_sec_key_e8f39b1a09d748c2b531"
    },
    {
      "key": "sampleUserId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01. Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "02. Auth",
      "item": [
        {
          "name": "Register New Staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nhanvien1@vietsage.edu.vn\",\n  \"password\": \"Password_123!\",\n  \"fullName\": \"Nguyễn Văn Một\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('adminAccessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('currentAccessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "  console.log('Admin Access Token saved!');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@vietsage.edu.vn\",\n  \"password\": \"AdminPassword_123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login as Staff",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('staffAccessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('currentAccessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "  console.log('Staff Access Token saved!');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@vietsage.edu.vn\",\n  \"password\": \"StaffPassword_123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Refresh Token Rotation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('currentAccessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "03. Users (RBAC)",
      "item": [
        {
          "name": "Get My Profile (Current User)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{currentAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "List All Users (Admin / Manager Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.length > 0) {",
                  "  const staff = json.data.find(u => u.role === 'STAFF') || json.data[0];",
                  "  pm.collectionVariables.set('sampleUserId', staff.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "role",
                  "value": "STAFF",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "ACTIVE",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Disable User (Admin Only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DISABLED\"\n}"
            },
            "url": "{{baseUrl}}/users/{{sampleUserId}}/status"
          }
        },
        {
          "name": "Activate User (Admin Only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/users/{{sampleUserId}}/status"
          }
        },
        {
          "name": "Change User Role to MANAGER (Admin Only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"MANAGER\"\n}"
            },
            "url": "{{baseUrl}}/users/{{sampleUserId}}/role"
          }
        }
      ]
    },
    {
      "name": "04. HN212 Device Adapter",
      "item": [
        {
          "name": "Push Face Recognition Event (Check-in)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-device-api-key",
                "value": "{{deviceApiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"EVT_HN212_001\",\n  \"deviceCode\": \"HN212-MAIN\",\n  \"occurredAt\": \"2026-10-18T08:00:00.000Z\",\n  \"method\": \"face\",\n  \"direction\": \"in\",\n  \"userCode\": \"EMP001\",\n  \"confidence\": 0.98\n}"
            },
            "url": "{{baseUrl}}/hn212/events"
          }
        },
        {
          "name": "Push Fingerprint Event (Check-out)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-device-api-key",
                "value": "{{deviceApiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"EVT_HN212_002\",\n  \"deviceCode\": \"HN212-MAIN\",\n  \"occurredAt\": \"2026-10-18T17:30:00.000Z\",\n  \"method\": \"fingerprint\",\n  \"direction\": \"out\",\n  \"userCode\": \"EMP001\"\n}"
            },
            "url": "{{baseUrl}}/hn212/events"
          }
        }
      ]
    },
    {
      "name": "05. Attendance",
      "item": [
        {
          "name": "Get My Attendance (Staff / Any Authenticated User)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staffAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/attendance/my"
          }
        },
        {
          "name": "Get All Attendance Records (Admin / Manager Only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/attendance"
          }
        }
      ]
    }
  ]
}