# Cấu hình ứng dụng
NODE_ENV=development
PORT=1000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:1000,http://localhost:5173,http://localhost:3000,https://vgv2316k-1000.asse.devtunnels.ms
DEV_TUNNEL_URL=https://vgv2316k-1000.asse.devtunnels.ms

# Thư mục lưu file log
LOG_DIR=../backend-logs
LOG_LEVEL=info

# PostgreSQL: dùng hostname postgres khi chạy bằng Docker Compose
DATABASE_URL=postgresql://vietsage:vietsage_dev_password@postgres:5432/vietsage_edu?schema=public

# Tạo secret ngẫu nhiên dài tối thiểu 32 ký tự trước khi triển khai thật
JWT_ACCESS_SECRET=replace_with_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_random_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# API key cho adapter HN212; đổi giá trị này trước khi chạy thật
HN212_API_KEY=dev-hn212-key
